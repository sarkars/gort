{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GORT agent.yaml",
  "description": "What gort init reads about one agent: its prompt, tools with risk tags, retrieval sources, memory, channels, agent types, languages and the team's own tags. Write it in JSON syntax (also valid YAML 1.2) or install PyYAML for block-style YAML. Chat layer first: voice and web channels are planned, not built.",
  "type": "object",
  "required": ["name", "prompt", "tools", "retrieval", "memory", "channels", "agent_types", "languages"],
  "additionalProperties": false,
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "prompt": {"anyOf": [{"type": "string", "minLength": 1}, {"$ref": "#/$defs/file"}], "description": "The system prompt text, or {\"file\": path}"},
    "tools": {"type": "array", "items": {"$ref": "#/$defs/tool"}},
    "retrieval": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "memory": {
      "type": "object",
      "required": ["scope"],
      "additionalProperties": false,
      "properties": {
        "scope": {"enum": ["none", "conversation", "across_conversations"]},
        "stores_personal_data": {"type": "boolean"}
      }
    },
    "channels": {"type": "array", "minItems": 1, "items": {"enum": ["chat", "voice", "web"]}},
    "agent_types": {"type": "array", "minItems": 1, "items": {"enum": ["conversational", "action", "document", "knowledge", "operations", "coding", "multi-agent"]}},
    "languages": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"}, "description": "Language tags such as en or en-US"},
    "tags": {"type": "object", "additionalProperties": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}]}, "description": "Team-added tags, name to value or values"}
  },
  "$defs": {
    "file": {"type": "object", "required": ["file"], "additionalProperties": false, "properties": {"file": {"type": "string", "minLength": 1}}},
    "tool": {
      "type": "object",
      "required": ["name", "description", "risk"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "risk": {"type": "array", "minItems": 1, "items": {"enum": ["read", "write", "external", "irreversible"]}, "description": "read: looks only; write: changes the team's data; external: reaches a person or system outside; irreversible: cannot be undone"}
      }
    },
    "source": {
      "type": "object",
      "required": ["name", "description"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1}
      }
    }
  }
}
